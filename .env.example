# ──────────────────────────────────────────────────────────────
# FinMind API — .env.example
# PATCHED: Auditoria de Segurança
#
# INSTRUÇÕES:
#  1. Copie este arquivo para .env
#  2. Substitua TODOS os valores placeholder pelos valores reais
#  3. NUNCA commite o arquivo .env no repositório
#  4. Use variáveis de ambiente do Render/Vercel em produção
# ──────────────────────────────────────────────────────────────

# ── Banco de dados ────────────────────────────────────────────
# Formato PostgreSQL com SSL obrigatório em produção
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── JWT ───────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Mínimo: 32 caracteres aleatórios
JWT_SECRET="GERE_UM_SECRET_ALEATORIO_DE_64_CHARS_AQUI"

# ── Servidor ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend ──────────────────────────────────────────────────
# URL do frontend (usado no CORS e nos redirects OAuth)
FRONTEND_URL="http://localhost:5173"

# ── Google OAuth ─────────────────────────────────────────────
# Obter em: https://console.cloud.google.com/apis/credentials
# Tipo: OAuth 2.0 Client IDs → Web application
GOOGLE_CLIENT_ID_WEB="YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# URL de callback — deve estar cadastrada no Google Console
# Desenvolvimento: http://localhost:3001/api/v1/auth/google/callback
# Produção:        https://SUA-API.onrender.com/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"

# IDs para mobile (Android/iOS) — opcionais para web
GOOGLE_CLIENT_ID_ANDROID="YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_IOS="YOUR_IOS_CLIENT_ID.apps.googleusercontent.com"

# ── OpenAI ────────────────────────────────────────────────────
# Opcional: features de IA ficam desabilitadas se ausente
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ── Narração por LLM (Claude/Anthropic) — FASE 5.1 (INFRA, inativo) ─
# Provider da narração financeira. DEFAULT = deterministic (comportamento atual).
# Só ativa Claude quando LLM_PROVIDER ∈ {anthropic|claude|llm} E ANTHROPIC_API_KEY
# estiver presente; caso contrário cai no narrador determinístico (sem chamada externa).
LLM_PROVIDER="deterministic"
# Chave da API Anthropic. Sem ela, o provider Claude fica indisponível (fallback).
ANTHROPIC_API_KEY=""
# Modelo Claude (sobrescreve o default claude-opus-4-8). Ex.: claude-haiku-4-5 (custo),
# claude-sonnet-4-6 (equilíbrio), claude-opus-4-8 (máxima qualidade).
LLM_MODEL="claude-opus-4-8"
# Timeout (ms) das chamadas ao LLM; em estouro, cai no determinístico.
LLM_TIMEOUT_MS="15000"

# ── Admin ─────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN="GERE_UM_ADMIN_TOKEN_ALEATORIO_AQUI"

# ── Growth Engine ─────────────────────────────────────────────
GROWTH_ROLLOUT_PERCENTAGE=10

# ── Observabilidade (Sentry) — opcional ───────────────────────
# Se ausente, observability fica OFF (deploy continua normal).
# Obter em: https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=""
# Ambiente para segregar eventos no Sentry (production | staging | development)
SENTRY_ENVIRONMENT="production"
# Release tag para correlacionar eventos com versão deployada (opcional)
# Pode usar git SHA: SENTRY_RELEASE=$(git rev-parse --short HEAD)
SENTRY_RELEASE=""

# ── Open Finance (Pluggy) ─────────────────────────────────────
# Obter em: https://dashboard.pluggy.ai → Credenciais
PLUGGY_CLIENT_ID="YOUR_PLUGGY_CLIENT_ID"
PLUGGY_CLIENT_SECRET="YOUR_PLUGGY_CLIENT_SECRET"

# Secret para validar assinatura HMAC dos webhooks Pluggy
# Configurar em: Pluggy Dashboard → Webhooks → Webhook Secret
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLUGGY_WEBHOOK_SECRET="GERE_UM_SECRET_ALEATORIO_AQUI"

# URL do webhook que o Pluggy vai chamar após cada sincronização
# Produção: https://SUA-API.onrender.com/api/v1/webhooks/pluggy
PLUGGY_WEBHOOK_URL="https://SUA-API.onrender.com/api/v1/webhooks/pluggy"

# Chave AES-256-GCM para criptografar IDs bancários (pluggyItemId, pluggyAccountId)
# DEVE ter exatamente 64 caracteres hexadecimais (= 32 bytes)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="GERE_64_CHARS_HEX_AQUI_NUNCA_COMPARTILHE_ESTA_CHAVE"
