// ──────────────────────────────────────────────────────────────
// FinMind API — prisma/schema.prisma
// PATCHED: Auditoria de Segurança
//
// Alterações aplicadas:
//  1. Índices adicionados em campos de busca frequente (email, userId, type)
//  2. AuthCode: índice em expiresAt para limpeza eficiente
//  3. AIUsage: índice em date para queries de uso diário
//  4. Sem alterações destrutivas — schema compatível com banco existente
//  5. Comentário de campo metadata atualizado (PostgreSQL, não SQLite)
//
// IMPORTANTE: Para aplicar no banco existente:
//   npx prisma migrate dev --name add_performance_indexes
//   (Em produção: npx prisma migrate deploy)
//   NÃO usar: npx prisma db push --accept-data-loss
// ──────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String?
  provider            String    @default("local") // "local" | "google" | "hybrid"
  googleId            String?   @unique
  avatarUrl           String?
  monthlyIncome       Float     @default(0.0)
  streakDays          Int       @default(0)
  xp                  Int       @default(0)
  level               Int       @default(1)
  isPremium           Boolean   @default(false)
  plan                String    @default("free") // "free" | "pro"
  onboardingCompleted Boolean   @default(false)
  lastCheckIn         DateTime?
  createdAt           DateTime  @default(now())
  environmentId       String?
  lgpdConsentAt       DateTime? // [MÉDIO-6] LGPD Art. 7, I — timestamp do consentimento

  environment    Environment?   @relation(fields: [environmentId], references: [id])
  transactions   Transaction[]
  goals          Goal[]
  insights       Insight[]
  userProfile    UserProfile?
  dailySnapshots DailySnapshot[]
  notifications  Notification[]
  patternAlerts  PatternAlert[]
  aiUsage        AIUsage[]
  events         Event[]
  growthActions  GrowthAction[]

  @@index([email])           // Busca por email no login
  @@index([googleId])        // Busca no OAuth Google
  @@index([createdAt])       // Métricas de admin segmentadas por data
}

model Environment {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  createdAt DateTime @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "income" | "expense"
  category    String
  amount      Float
  date        DateTime
  description String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])           // Todas as queries de transação filtram por userId
  @@index([userId, date])     // Queries de resumo mensal
  @@index([userId, type])     // Filtros por tipo (receita/despesa)
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  title         String
  type          String   @default("general")
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Insight {
  id        String   @id @default(cuid())
  userId    String
  message   String
  type      String   // "warning" | "suggestion" | "achievement"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model DailySnapshot {
  id                String   @id @default(cuid())
  userId            String
  balance           Float
  monthlyExpenses   Float
  savingsRate       Float
  riskLevel         String
  predictedExpenses Float
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  message   String
  type      String
  priority  String   @default("low")
  read      Boolean  @default(false)
  sendAt    DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])    // Busca de notificações não lidas
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  spendingPattern String
  riskTolerance   String
  lastUpdated     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatternAlert {
  id         String   @id @default(cuid())
  userId     String
  category   String
  percentage Float
  message    String
  severity   String   // "low" | "medium" | "high"
  detectedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  category  String?
  metadata  String?  // JSON stringificado
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])            // Queries de telemetria por tipo de evento
  @@index([createdAt])       // Métricas de admin segmentadas por data
}

model AIUsage {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @default(now())
  count  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])    // Query diária de uso de IA
}

model AuthCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])       // Limpeza eficiente de códigos expirados
  @@index([userId])          // Limpeza por usuário no callback
}

model GrowthAction {
  id        String   @id @default(cuid())
  userId    String
  ruleKey   String   @default("legacy")
  type      String
  channel   String?  @default("notification")
  metadata  String?
  status    String   @default("pending")
  isShadow  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ─── Open Finance (Pluggy) ───────────────────────────────────

model BankConnection {
  id                 String    @id @default(cuid())
  userId             String
  // pluggyItemId armazenado criptografado (AES-256-GCM) — nunca em plaintext
  pluggyItemIdEnc    String    @unique
  // HMAC-SHA256 determinístico para lookup eficiente (não é reversível)
  pluggyItemIdHmac   String    @unique
  institutionId      String
  institutionName    String
  institutionLogo    String?
  // UPDATING | UPDATED | LOGIN_ERROR | OUTDATED | WAITING_USER_INPUT
  status             String    @default("UPDATING")
  errorCode          String?
  errorMessage       String?
  consentExpiresAt   DateTime?
  lastSyncAt         DateTime?
  lastSyncTxCount    Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts BankAccount[]

  @@index([userId])
  @@index([userId, status])
  @@index([consentExpiresAt])   // Para job de expiração de consentimento
}

model BankAccount {
  id                   String    @id @default(cuid())
  connectionId         String
  userId               String
  // pluggyAccountId criptografado
  pluggyAccountIdEnc   String    @unique
  // HMAC-SHA256 para lookup
  pluggyAccountIdHmac  String    @unique
  type                 String    // BANK | CREDIT
  subtype             String?   // CHECKING | SAVINGS | CREDIT_CARD
  name                String
  number              String?   // últimos 4 dígitos apenas (não criptografar)
  balance             Float     @default(0)
  balanceDate         DateTime?
  currencyCode        String    @default("BRL")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  connection   BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([connectionId])
  @@index([userId])
}

model BankTransaction {
  id               String    @id @default(cuid())
  accountId        String
  userId           String
  // pluggyTxId não é PII — é apenas ID de referência do Pluggy
  pluggyTxId       String    @unique
  date             DateTime
  description      String
  amount           Float     // positivo = crédito, negativo = débito
  currencyCode     String    @default("BRL")
  type             String    // DEBIT | CREDIT
  pluggyCategory   String?   // categoria original do Pluggy
  finmindCategory  String?   // normalizada para categorias do FinMind
  merchant         String?   // nome do estabelecimento (se disponível)
  balance          Float?    // saldo após transação (se disponível)
  // null = não importada; preenchida após o usuário importar para Transaction
  importedTxId     String?
  createdAt        DateTime  @default(now())

  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([userId, date])
  @@index([userId, finmindCategory])
  @@index([importedTxId])          // Para checar duplicatas
}
