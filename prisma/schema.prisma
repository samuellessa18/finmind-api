generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String?
  provider        String   @default("local") // "local" | "google" | "hybrid"
  googleId        String?  @unique
  avatarUrl       String?
  monthlyIncome   Float    @default(0.0)
  streakDays      Int      @default(0)
  xp              Int      @default(0)
  level           Int      @default(1)
  isPremium       Boolean  @default(false)
  plan            String   @default("free") // "free" | "pro"
  onboardingCompleted Boolean @default(false)
  lastCheckIn     DateTime?
  createdAt       DateTime @default(now())
  environmentId   String?
  environment     Environment? @relation(fields: [environmentId], references: [id])
  
  transactions   Transaction[]
  goals         Goal[]
  insights      Insight[]
  userProfile   UserProfile?
  dailySnapshots DailySnapshot[]
  notifications Notification[]
  patternAlerts PatternAlert[]
  aiUsage       AIUsage[]
  events        Event[]
  growthActions GrowthAction[]
}

model Environment {
  id        String   @id @default(cuid())
  name      String
  users     User[]
  createdAt DateTime @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "income" or "expense"
  category    String
  amount      Float
  date        DateTime
  description String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id              String   @id @default(cuid())
  userId          String
  title           String
  type            String   @default("general") // viagem, casa, carro
  targetAmount    Float
  currentAmount   Float    @default(0)
  deadline        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Insight {
  id        String   @id @default(cuid())
  userId    String
  message   String
  type      String   // "warning", "suggestion", "achievement"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailySnapshot {
  id                String   @id @default(cuid())
  userId            String
  balance           Float
  monthlyExpenses   Float
  savingsRate       Float
  riskLevel         String
  predictedExpenses Float
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  message   String
  type      String
  priority  String   @default("low")
  read      Boolean  @default(false)
  sendAt    DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  spendingPattern String
  riskTolerance   String
  lastUpdated     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatternAlert {
  id            String   @id @default(cuid())
  userId        String
  category      String
  percentage    Float
  message       String
  severity      String   // "low", "medium", "high"
  detectedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  category  String?
  metadata  String?  // JSON stringified for SQLite compatibility
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AIUsage {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now()) // Normalized to YYYY-MM-DD
  count     Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
model AuthCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model GrowthAction {
  id        String   @id @default(cuid())
  userId    String
  ruleKey   String   @default("legacy")
  type      String
  channel   String?  @default("notification")
  metadata  String?
  status    String   @default("pending")
  isShadow  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

