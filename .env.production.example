# FinMind Backend - Production Environment Variables
# Use these variables when deploying to Render

# Database (PostgreSQL on Render)
# Format: postgresql://username:password@host:5432/database?sslmode=require
DATABASE_URL="postgresql://user:password@dpg-d7odoifavr4c73bqmefg-a.oregon-postgres.render.com:5432/finmind_db?sslmode=require"

# JWT Secret (change this to a secure random string)
