# ──────────────────────────────────────────────────────────────
# FinMind API — .env.production.example
# PATCHED: Auditoria de Segurança
#
# IMPORTANTE:
#  - NÃO contém valores reais de produção
#  - NÃO commitar valores reais
#  - Configure as variáveis diretamente no painel do Render
#  - CORRIGIDO: host real do banco removido (estava exposto na versão anterior)
# ──────────────────────────────────────────────────────────────

# ── Banco de dados PostgreSQL (Render) ────────────────────────
# Obtido no painel do Render → seu banco → Connection → External Database URL
# IMPORTANTE: sempre incluir ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@dpg-XXXXXXXXXXXXXXXXX-a.REGION-postgres.render.com:5432/DB_NAME?sslmode=require"

# ── JWT ───────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GERE_COM_64_BYTES_ALEATORIOS_node_crypto_randomBytes"

# ── Servidor ──────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ── Frontend ──────────────────────────────────────────────────
# URL exata do seu deploy no Vercel (sem barra final)
FRONTEND_URL="https://SEU-APP.vercel.app"

# ── Google OAuth ─────────────────────────────────────────────
# Credenciais do Google Console (projeto de produção)
# Authorized redirect URI deve incluir:
#   https://SUA-API.onrender.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID_WEB="YOUR_WEB_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="https://SUA-API.onrender.com/api/v1/auth/google/callback"

# Mobile (se usar Expo)
GOOGLE_CLIENT_ID_ANDROID="YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_IOS="YOUR_IOS_CLIENT_ID.apps.googleusercontent.com"

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY="sk-your-production-openai-key"

# ── Admin ─────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo: 32 caracteres aleatórios
ADMIN_TOKEN="GERE_UM_ADMIN_TOKEN_FORTE_AQUI"

# ── Growth Engine ─────────────────────────────────────────────
GROWTH_ROLLOUT_PERCENTAGE=10
