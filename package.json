{
  "name": "finmind-backend",
  "version": "1.0.0",
  "description": "Backend API for FinMind financial control app",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npx prisma generate --schema=./prisma/schema.prisma && npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "validate": "node scripts/validate.js",
    "check": "node scripts/validate.js",
    "audit:high": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^7.120.4",
    "axios": "^1.18.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.2",
    "openai": "^4.20.1",
    "pg": "^8.22.0",
    "prisma": "^5.22.0",
    "uuid": "^11.1.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
